{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/collector hook",
            "commandWindows": "${PLUGIN_ROOT}\\bin\\collector.exe hook",
            "timeout": 30,
            "statusMessage": "准备采集仓库"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/collector hook",
            "commandWindows": "${PLUGIN_ROOT}\\bin\\collector.exe hook",
            "timeout": 60,
            "statusMessage": "记录本轮文件变化"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/collector hook",
            "commandWindows": "${PLUGIN_ROOT}\\bin\\collector.exe hook",
            "timeout": 3,
            "statusMessage": "结束采集会话"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/collector hook",
            "commandWindows": "${PLUGIN_ROOT}\\bin\\collector.exe hook",
            "timeout": 3,
            "statusMessage": "记录本轮中断"
          }
        ]
      }
    ]
  }
}
